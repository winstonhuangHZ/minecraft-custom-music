{
  "schemaVersion": 1,
  "id": "custommusic",
  "version": "${version}",
  "name": "Custom Music",
  "description": "把 mp3 丢进文件夹，模组自动转码成 OGG 并接管游戏背景音乐。两种模式：歌单播放器 / 按情境替换配乐。装了 ModMenu 可以直接从模组列表打开设置界面。",
  "authors": [
    "you"
  ],
  "license": "MIT",
  "contact": {
    "homepage": "https://github.com/winstonhuangHZ/minecraft-custom-music",
    "sources": "https://github.com/winstonhuangHZ/minecraft-custom-music",
    "issues": "https://github.com/winstonhuangHZ/minecraft-custom-music/issues"
  },
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.custommusic.CustomMusicClient"
    ],
    "modmenu": [
      "com.custommusic.modmenu.ModMenuIntegration"
    ]
  },
  "mixins": [
    "custommusic.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_min_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25"
  },
  "suggests": {
    "modmenu": "*"
  }
}
